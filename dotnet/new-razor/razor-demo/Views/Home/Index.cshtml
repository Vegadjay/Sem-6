@{
    ViewData["Title"] = "Home Page";
}

@{
    string name = "Jay vegad";
    string enrollmentNumber = "23010101294";
    int[] semester = { 1, 2, 3, 4, 5, 6 };
    float[] spi = { 9.0f, 9.2f, 9.4f, 9.6f, 9.8f, 10.0f };
}

<table border="1">
    <tr>
        <th>Name</th>
        <th>Enrollment Number</th>
        <th>Semester</th>
        <th>SPI</th>
    </tr>
    @for (int i = 0; i < spi.Length; i++)
    {
        <tr>
            <td>@name</td>
            <td>@enrollmentNumber</td>
            <td>@semester[i]</td>
            <td>@spi[i]</td>
        </tr>
    }
</table>
