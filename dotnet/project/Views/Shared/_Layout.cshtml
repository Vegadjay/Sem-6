    ======================================================== -->
</head>

<body>

    <!-- ======= Header ======= -->
    <header id="header" class="header fixed-top d-flex align-items-center">

        <div class="d-flex align-items-center justify-content-between">
            <a href="index.html" class="logo d-flex align-items-center">
                <span class="d-none d-lg-block">MOM</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div><!-- End Logo -->

        <div class="search-bar">
            <form class="search-form d-flex align-items-center" method="POST" action="#">
                <input type="text" name="query" placeholder="Search" title="Enter search keyword">
                <button type="submit" title="Search"><i class="bi bi-search"></i></button>
            </form>
        </div><!-- End Search Bar -->

        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">

                <li class="nav-item d-block d-lg-none">
                    <a class="nav-link nav-icon search-bar-toggle " href="#">
                        <i class="bi bi-search"></i>
                    </a>
                </li><!-- End Search Icon-->

                

                <li  class="nav-item dropdown pe-3">

                    <a style="width: 120px;" class="nav-link nav-profile d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                        <img src="https://jayvegaddev.vercel.app/profile-pic/profile-pic.jpeg" alt="Profile" class="rounded-circle" style="width: 100%; height:100%">
                        <span class="d-none d-md-block dropdown-toggle ps-2">Jay Vegad</span>
                    </a><!-- End Profile Iamge Icon -->

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>Jay Vegad</h6>
                            <span>Web Designer</span>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person"></i>
                                <span>My Profile</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Settings" asp-action="Index">
                                <i class="bi bi-gear"></i>
                                <span>Account Settings</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="pages-faq.html">
                                <i class="bi bi-question-circle"></i>
                                <span>Need Help?</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="#">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sign Out</span>
                            </a>
                        </li>

                    </ul><!-- End Profile Dropdown Items -->
                </li><!-- End Profile Nav -->

            </ul>
        </nav><!-- End Icons Navigation -->

    </header><!-- End Header -->
    <!-- ======= Sidebar ======= -->
    <aside id="sidebar" class="sidebar">

        <ul class="sidebar-nav" id="sidebar-nav">

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>
            </li><!-- End Dashboard Nav -->

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Department" asp-action="DepartmentList">
                    <i class="bi bi-grid"></i>
                    <span>Departments</span>
                </a>
            </li><!-- End Department Nav -->
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="MeetingType" asp-action="MeetingTypeList">
                    <i class="bi bi-grid"></i>
                    <span>Meeting Types</span>
                </a>
            </li><!-- End MeetingType Nav -->
            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#tables-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-layout-text-window-reverse"></i><span>Meetings</span><i class="bi bi-chevron-down ms-auto"></i>
                </a>
                <ul id="tables-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
                    <li>
                        <a asp-controller="Meeting" asp-action="MeetingList">
                            <i class="bi bi-circle"></i><span>Meeting Lists</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Meeting" asp-action="MeetingAddEdit">
                            <i class="bi bi-circle"></i><span>Add Meeting</span>
                        </a>
                    </li>
                </ul>
            </li><!-- End Meeting Nav -->

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="MeetingVenue" asp-action="MeetingVenueList">
                    <i class="bi bi-grid"></i>
                    <span>Meeting Venues</span>
                </a>
            </li><!-- End MeetingVenue Nav -->
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="MeetingMember" asp-action="MeetingMemberList">
                    <i class="bi bi-grid"></i>
                    <span>Meeting Members</span>
                </a>
            </li><!-- End MeetingMember Nav -->
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Staff" asp-action="StaffList">
                    <i class="bi bi-grid"></i>
                    <span>Staff</span>
                </a>
            </li><!-- End Staff Nav -->


        </ul>

    </aside><!-- End Sidebar-->

    <main id="main" class="main">

        @RenderBody()

    </main><!-- End #main -->
