<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@(ViewData["Title"] ?? "Dashboard") - MOM</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Geist Font (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="~/assets/vendor/quill/quill.snow.css" rel="stylesheet">
    <link href="~/assets/vendor/quill/quill.bubble.css" rel="stylesheet">
    <link href="~/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
    <link href="~/assets/vendor/simple-datatables/style.css" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="~/assets/css/style.css" rel="stylesheet">

    <!-- =======================================================
    * Template Name: NiceAdmin
    * Template URL: https://bootstrapmade.com/nice-admin-bootstrap-admin-html-template/
    * Updated: Apr 20 2024 with Bootstrap v5.3.3
    * Author: BootstrapMade.com
    * License: https://bootstrapmade.com/license/
    ======================================================== -->
</head>

<body>

    <!-- ======= Navbar / Header ======= -->
    <header id="header" class="header fixed-top">
        <div class="header-inner d-flex align-items-center">
            <div class="header-brand d-flex align-items-center">
                <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center text-decoration-none">
                    <img src="~/assets/img/logo.png" alt="MOM Logo">
                    <span class="d-none d-lg-block ms-2">MOM</span>
                </a>
                <button type="button" class="btn btn-link p-0 border-0 d-inline-flex align-items-center justify-content-center toggle-sidebar-btn ms-2" aria-label="Toggle sidebar">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </div>

            <div class="search-bar d-none d-md-flex flex-grow-1 justify-content-center mx-3">
                <form class="search-form d-flex align-items-center" method="get" action="#">
                    <input type="text" name="query" placeholder="Search meetings, staff..." title="Enter search keyword">
                    <button type="submit" title="Search" class="border-0 bg-transparent">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <nav class="header-nav ms-auto d-flex align-items-center">
                <ul class="navbar-nav flex-row align-items-center gap-1">
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-icon position-relative rounded-2" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell"></i>
                            <span class="badge bg-danger badge-number position-absolute top-0 start-100 translate-middle">3</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 notifications py-2">
                            <li class="px-3 py-2 border-bottom">
                                <span class="small fw-semibold text-dark">Notifications</span>
                            </li>
                            <li class="notification-item">
                                <i class="bi bi-calendar-check text-primary"></i>
                                <div>
                                    <h4>New Meeting</h4>
                                    <p>Board Meeting scheduled</p>
                                    <p class="small text-muted mb-0">30 min ago</p>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li class="notification-item">
                                <i class="bi bi-check-circle text-success"></i>
                                <div>
                                    <h4>Attendance Updated</h4>
                                    <p>Marketing Team</p>
                                    <p class="small text-muted mb-0">1 hr ago</p>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li class="px-3 py-2">
                                <a href="#" class="small text-primary text-decoration-none">Show all</a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-profile d-flex align-items-center rounded-2 pe-0" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle" width="36" height="36" style="object-fit: cover;">
                            <span class="d-none d-md-block dropdown-toggle ps-2 fw-medium">Jay Vegad</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 profile py-2">
                            <li class="px-3 py-2 border-bottom">
                                <h6 class="mb-0 fw-semibold">Jay Vegad</h6>
                                <span class="small text-muted">Admin</span>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person"></i>
                                    <span>My Profile</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear"></i>
                                    <span>Account Settings</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 text-danger" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Sign Out</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

<!-- End Header -->
    <!-- ======= Sidebar ======= -->
    <aside id="sidebar" class="sidebar">
        <ul class="sidebar-nav list-unstyled mb-0" id="sidebar-nav">

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Department" asp-action="DepartmentList">
                    <i class="bi bi-building"></i>
                    <span>Departments</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="MeetingType" asp-action="MeetingTypeList">
                    <i class="bi bi-calendar-event"></i>
                    <span>Meeting Types</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" data-bs-target="#tables-nav" data-bs-toggle="collapse" href="#">
                    <i class="bi bi-calendar-week"></i>
                    <span>Meetings</span>
                    <i class="bi bi-chevron-down ms-auto sidebar-chevron"></i>
                </a>
                <ul id="tables-nav" class="nav-content collapse list-unstyled" data-bs-parent="#sidebar-nav">
                    <li class="nav-subitem">
                        <a class="nav-sublink" asp-controller="Meeting" asp-action="MeetingList">
                            <span class="nav-sublink-dot"></span>
                            <span>Meeting Lists</span>
                        </a>
                    </li>
                    <li class="nav-subitem">
                        <a class="nav-sublink" asp-controller="Meeting" asp-action="MeetingAddEdit">
                            <span class="nav-sublink-dot"></span>
                            <span>Add Meeting</span>
                        </a>
                    </li>
                    <li class="nav-subitem">
                        <a class="nav-sublink" asp-controller="Meeting" asp-action="Attandance">
                            <span class="nav-sublink-dot"></span>
                            <span>Attendance</span>
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="MeetingVenue" asp-action="MeetingVenueList">
                    <i class="bi bi-geo-alt"></i>
                    <span>Meeting Venues</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="MeetingMember" asp-action="MeetingMemberList">
                    <i class="bi bi-people"></i>
                    <span>Meeting Members</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Staff" asp-action="StaffList">
                    <i class="bi bi-person-badge"></i>
                    <span>Staff</span>
                </a>
            </li>

        </ul>
    </aside>

    <main id="main" class="main">

        @RenderBody()

    </main><!-- End #main -->

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="modal-header border-0 pb-0 pt-4 px-4">
            <h5 class="modal-title d-flex align-items-center text-danger fw-bold" id="deleteModalLabel">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-4"></i> Confirm Deletion
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body py-3 px-4 text-muted">
            <p class="mb-0 fs-5">Are you sure you want to delete this item?</p>
            <p class="mb-0 small mt-1">This action cannot be undone and the data will be permanently removed.</p>
          </div>
          <div class="modal-footer border-0 pt-0 pb-4 px-4">
            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <a id="btnConfirmDelete" href="#" class="btn btn-danger rounded-pill px-4 shadow-sm">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
          </div>
        </div>
      </div>
    </div>

    <script>
        function confirmDelete(url) {
            var deleteModalElement = document.getElementById('deleteModal');
            var deleteModal = new bootstrap.Modal(deleteModalElement);
            document.getElementById('btnConfirmDelete').setAttribute('href', url);
            deleteModal.show();
        }
    </script>

    <!-- ======= Footer ======= -->
    <footer id="footer" class="footer d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="copyright">
            &copy; <strong><span>MOM</span></strong> — Minutes of Meeting. All Rights Reserved.
        </div>
        <div class="credits text-muted">
            Meeting management &amp; attendance tracking system.
        </div>
    </footer><!-- End Footer -->

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/chart.js/chart.umd.js"></script>
    <script src="~/assets/vendor/echarts/echarts.min.js"></script>
    <script src="~/assets/vendor/quill/quill.js"></script>
    <script src="~/assets/vendor/simple-datatables/simple-datatables.js"></script>
    <script src="~/assets/vendor/tinymce/tinymce.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>

    <!-- Template Main JS File -->
    <script src="~/assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>