@model MOM.ViewModels.AttendanceViewModel
@{
    ViewData["Title"] = "Attendance";
}

<div class="pagetitle">
    <h1><i class="bi bi-clipboard-check text-primary me-2"></i>Attendance</h1>
    <p class="text-muted mb-0">Select a meeting to manage attendee attendance</p>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Meeting" asp-action="MeetingList">Meetings</a></li>
            <li class="breadcrumb-item active">Attendance</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body py-4">
                    <form asp-action="Attandance" method="get" class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Select Meeting</label>
                            <select name="id" class="form-select form-select-lg border-2 border-primary border-opacity-25" onchange="this.form.submit()" asp-items="@(new SelectList(ViewBag.Meetings, "MeetingId", "MeetingDate", Model.MeetingId))">
                                <option value="">-- Choose a Meeting --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            @if (Model.MeetingId > 0)
                            {
                                <div class="bg-light p-3 rounded-3 border">
                                    <div class="small text-muted text-uppercase fw-bold mb-1">Active Meeting</div>
                                    <div class="fw-bold text-primary">@Model.MeetingDate.ToString("MMMM dd, yyyy - HH:mm")</div>
                                    <div class="small">@Model.MeetingTitle</div>
                                </div>
                            }
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.MeetingId > 0)
            {
                <div class="card border-0 shadow-sm animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Attendance Sheet</h5>
                        <div class="text-muted small">Total Staff: @Model.Attendees.Count</div>
                    </div>
                    <div class="card-body pt-0">
                        <form asp-action="SaveAttendance" method="post">
                            <input type="hidden" asp-for="MeetingId" />
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 50px;">#</th>
                                            <th>Staff Name</th>
                                            <th>Department</th>
                                            <th class="text-center" style="width: 150px;">Present</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Attendees.Count; i++)
                                        {
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>
                                                    <input type="hidden" asp-for="Attendees[i].StaffId" />
                                                    <input type="hidden" asp-for="Attendees[i].StaffName" />
                                                    <div class="fw-semibold">@Model.Attendees[i].StaffName</div>
                                                </td>
                                                <td>
                                                    <input type="hidden" asp-for="Attendees[i].DepartmentName" />
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">@Model.Attendees[i].DepartmentName</span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check form-switch d-inline-block">
                                                        <input class="form-check-input" type="checkbox" asp-for="Attendees[i].IsPresent" id="check_@i">
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="text" asp-for="Attendees[i].Remarks" class="form-control form-control-sm" placeholder="Optional notes" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
                                <a asp-action="MeetingList" class="btn btn-light px-4">Done</a>
                                <button type="submit" class="btn btn-primary px-5">
                                    <i class="bi bi-save me-2"></i>Save Attendance
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <img src="https://illustrations.popsy.co/amber/calendar.svg" alt="Select Meeting" style="max-width: 200px;" class="mb-4 opacity-75">
                    <h4 class="text-muted">No meeting selected</h4>
                    <p class="text-secondary">Please choose a meeting from the dropdown above to start marking attendance.</p>
                </div>
            }
        </div>
    </div>
</section>

@section Styles {
    <style>
        .form-select-lg { font-size: 1.1rem; }
        .table thead th { border-top: none; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; }
        .form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
    </style>
}
