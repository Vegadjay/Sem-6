@model IEnumerable<MOM.Models.MeetingVenueModel>
@{
    ViewData["Title"] = "Meeting Venue List";
}

<div class="pagetitle">
    <h1>Meeting Venues</h1>
    <p class="text-muted">Manage meeting locations</p>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">Meeting Venue</li>
            <li class="breadcrumb-item active">List</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-transparent border-0 d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <h5 class="card-title mb-0 d-flex align-items-center">
                        <i class="bi bi-geo-alt me-2 text-primary"></i> Meeting Venues
                    </h5>
                    <div class="d-flex gap-2">
                        <form class="d-flex" method="get">
                            <input type="text" name="SearchText" class="form-control form-control-sm me-2" placeholder="Search venues..." value="@ViewBag.CurrentSearchText">
                            <button type="submit" class="btn btn-light btn-sm"><i class="bi bi-search"></i></button>
                        </form>
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> Add Venue
                        </a>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover datatable align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int count = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><span class="fw-medium">@count</span></td>
                                            <td>@item.MeetingVenueName</td>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    <a asp-action="Update" asp-route-id="@item.MeetingVenueID" class="btn btn-outline-primary btn-sm" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete", new { id = item.MeetingVenueID })')" class="btn btn-outline-danger btn-sm" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        count++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="table-empty-state text-center py-4 text-muted">No venues found. Add your first venue above.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
