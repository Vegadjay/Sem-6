@model MOM.Models.MeetingTypeModel
@{
    ViewData["Title"] = Model.MeetingTypeId == 0 ? "Add Meeting Type" : "Edit Meeting Type";
}

<div class="pagetitle">
    <h1>@(Model.MeetingTypeId == 0 ? "Add" : "Edit") Meeting Type</h1>
    <p class="text-muted mb-0">@(Model.MeetingTypeId == 0 ? "Create a meeting type" : "Update meeting type")</p>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="MeetingType" asp-action="MeetingTypeList">Meeting Type</a></li>
            <li class="breadcrumb-item active">@(Model.MeetingTypeId == 0 ? "Add" : "Edit")</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="card-title mb-0 d-flex align-items-center">
                        <i class="bi bi-calendar-event me-2 text-primary"></i>
                        @(Model.MeetingTypeId == 0 ? "New Meeting Type" : "Edit Meeting Type")
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="Save" method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="MeetingTypeId" />
                        <input type="hidden" asp-for="Created" />
                        <input type="hidden" asp-for="Modified" />

                        <div class="col-12">
                            <label asp-for="MeetingTypeName" class="form-label">Type Name</label>
                            <input asp-for="MeetingTypeName" class="form-control" placeholder="e.g. Board Meeting" />
                            <span asp-validation-for="MeetingTypeName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label">Remarks</label>
                            <input asp-for="Remarks" class="form-control" placeholder="Optional remarks" />
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end pt-2 border-top mt-3">
                            <a asp-action="MeetingTypeList" class="btn btn-outline-secondary">Cancel</a>
                            <button type="reset" class="btn btn-secondary">Reset</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
