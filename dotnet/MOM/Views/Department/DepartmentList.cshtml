@model IEnumerable<MOM.Models.DepartmentModel>
@{
    ViewData["Title"] = "Department List";
}

<div class="pagetitle">
    <h1>Departments</h1>
    <p class="text-muted">Manage organization departments</p>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">Department</li>
            <li class="breadcrumb-item active">List</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-transparent border-0 d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <h5 class="card-title mb-0 d-flex align-items-center">
                        <i class="bi bi-building me-2 text-primary"></i> Departments
                    </h5>
                    <a asp-action="DepartmentAddEdit" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i> Add Department
                    </a>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover datatable align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th data-type="date" data-format="YYYY/MM/DD">Created</th>
                                    <th data-type="date" data-format="YYYY/MM/DD">Modified</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><span class="fw-medium">@item.DepartmentID</span></td>
                                            <td>@item.DepartmentName</td>
                                            <td>@item.Created.ToString("yyyy/MM/dd")</td>
                                            <td>@item.Modified.ToString("yyyy/MM/dd")</td>
                                            <td class="text-end">
                                                <a asp-action="DepartmentAddEdit" asp-route-id="@item.DepartmentID" class="btn btn-outline-primary btn-sm" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete", "Department", new { id = item.DepartmentID })')" class="btn btn-outline-danger btn-sm" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="table-empty-state">No departments found. Add your first department above.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
