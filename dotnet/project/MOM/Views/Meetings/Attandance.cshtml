@{
    ViewData["Title"] = "Attendance";
}

<div class="pagetitle">
    <h1>Attendance</h1>
    <p class="text-muted mb-0">Manage meeting attendance and reports</p>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Attendance</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3 flex-shrink-0">
                        <i class="bi bi-calendar-check text-primary fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-1">Select Meeting</h6>
                        <p class="mb-0 small">Choose a meeting to view or manage attendance.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 me-3 flex-shrink-0">
                        <i class="bi bi-people text-success fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-1">Mark Attendance</h6>
                        <p class="mb-0 small">Record who was present or absent.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 flex-shrink-0" style="background: rgba(139, 92, 246, 0.12);">
                        <i class="bi bi-file-earmark-bar-graph fs-2" style="color: #8b5cf6;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-1">Reports</h6>
                        <p class="mb-0 small">Generate attendance reports and analytics.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="card-title mb-0 d-flex align-items-center">
                        <i class="bi bi-clipboard-check me-2 text-primary"></i> Manage Attendance
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <p class="text-muted mb-0">Select a meeting from the list to view attendees, mark presence, or export reports. Use the <a asp-controller="MeetingMember" asp-action="MeetingMemberList" class="text-primary">Meeting Members</a> section to manage individual attendance records.</p>
                </div>
            </div>
        </div>
    </div>
</section>
