@model MOM.Models.MeetingMemberModel
@{
    ViewData["Title"] = Model.MeetingMemberID == 0 ? "Add Member" : "Edit Member";
}

<div class="pagetitle">
    <h1>@(Model.MeetingMemberID == 0 ? "Add" : "Edit") Meeting Member</h1>
    <p class="text-muted mb-0">@(Model.MeetingMemberID == 0 ? "Add a member to a meeting" : "Update attendance or remarks")</p>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="MeetingMember" asp-action="Index">Meeting Members</a></li>
            <li class="breadcrumb-item active">@(Model.MeetingMemberID == 0 ? "Add" : "Edit")</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-transparent border-0 py-3">
                    <h5 class="card-title mb-0 d-flex align-items-center">
                        <i class="bi bi-people me-2 text-primary"></i>
                        @(Model.MeetingMemberID == 0 ? "New Meeting Member" : "Edit Meeting Member")
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <form asp-action="@(Model?.MeetingMemberID == 0 ? "Create" : "Update")" method="post" class="row g-3">
                        <input type="hidden" asp-for="MeetingMemberID" />
                        <input type="hidden" asp-for="Created" />
                        <input type="hidden" asp-for="Modified" />

                        <div class="col-md-6">
                            <label asp-for="MeetingID" class="form-label">Meeting</label>
                            <select asp-for="MeetingID" class="form-select" asp-items="@(new SelectList(ViewBag.MeetingList, "MeetingID", "DisplayName"))">
                                <option value="">Select Meeting</option>
                            </select>
                            <span asp-validation-for="MeetingID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StaffID" class="form-label">Staff Member</label>
                            <select asp-for="StaffID" class="form-select" asp-items="@(new SelectList(ViewBag.StaffList, "StaffID", "StaffName"))">
                                <option value="">Select Staff</option>
                            </select>
                            <span asp-validation-for="StaffID" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsPresent" id="IsPresent">
                                <label class="form-check-label" asp-for="IsPresent">Mark as Present</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Optional remarks"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end pt-2 border-top mt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="reset" class="btn btn-secondary">Reset</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
