@model MOM.Models.MeetingsModel
@{
    ViewData["Title"] = "Meeting Details";
    var staffList = ViewBag.StaffList as IEnumerable<MOM.Models.StaffModel> ?? new List<MOM.Models.StaffModel>();
    var currentMemberIds = Model.MeetingMembers?.Select(mm => mm.StaffID) ?? Enumerable.Empty<int?>();
    var availableStaff = staffList.Where(s => !currentMemberIds.Contains(s.StaffID)).ToList();
}

<div class="pagetitle">
    <h1>Meeting Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Meetings" asp-action="Index">Meetings</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <!-- Meeting Info Card -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-primary bg-opacity-10 border-0 pt-4 px-4 pb-0">
                    <h5 class="card-title mb-0 d-flex align-items-center text-primary">
                        <i class="bi bi-info-circle me-2"></i> Overview
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold">Date & Time</label>
                        <div class="fs-5 fw-medium">@Model.MeetingDate?.ToString("MMMM dd, yyyy")</div>
                        <div class="text-secondary">@Model.MeetingDate?.ToString("HH:mm")</div>
                    </div>

                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold">Venue</label>
                        <div class="fw-medium">@Model.MeetingVenue?.MeetingVenueName</div>
                        <div class="text-secondary small">@Model.MeetingVenue?.MeetingVenueName</div>
                    </div>

                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold">Type</label>
                        <div>
                            <span class="badge bg-info-light text-info px-3 py-2 rounded-pill border border-info-subtle">
                                @Model.MeetingType?.MeetingTypeName
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold">Department</label>
                        <div class="fw-medium">@Model.Department?.DepartmentName</div>
                    </div>

                    <div>
                        <label class="small text-muted text-uppercase fw-bold">Description</label>
                        <p class="text-secondary mb-0">@(string.IsNullOrEmpty(Model.MeetingDescription) ? "No description provided." : Model.MeetingDescription)</p>
                    </div>
                </div>
                <div class="card-footer bg-light bg-opacity-50 border-0 p-4 pt-0">
                    <a asp-action="Update" asp-route-id="@Model.MeetingID" class="btn btn-outline-primary btn-sm rounded-pill w-100 mb-2">
                        <i class="bi bi-pencil me-1"></i> Edit Meeting
                    </a>
                    <a asp-action="Index" class="btn btn-light btn-sm rounded-pill w-100">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <!-- Staff Management Card -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 d-flex align-items-center">
                        <i class="bi bi-people me-2 text-primary"></i> Meeting Members
                    </h5>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Member
                    </button>
                </div>

                <div class="card-body px-0">
                    @if (Model.MeetingMembers != null && Model.MeetingMembers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light bg-opacity-50">
                                    <tr>
                                        <th class="ps-4">Staff Name</th>
                                        <th>Department</th>
                                        <th>Attendance</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in Model.MeetingMembers)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-light p-2 me-3">
                                                        <i class="bi bi-person text-secondary"></i>
                                                    </div>
                                                    <div class="fw-medium">@member.Staff?.StaffName</div>
                                                </div>
                                            </td>
                                            <td>@member.Staff?.Department?.DepartmentName</td>
                                            <td>
                                                @if (member.IsPresent)
                                                {
                                                    <span class="badge rounded-pill bg-success-light text-success border border-success-subtle px-3">Present</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill bg-danger-light text-danger border border-danger-subtle px-3">Absent</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <form asp-action="RemoveMember" method="post" class="d-inline" onsubmit="return confirm('Remove this member from meeting?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="meetingMemberId" value="@member.MeetingMemberID" />
                                                    <input type="hidden" name="meetingId" value="@Model.MeetingID" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle shadow-sm" title="Remove Member">
                                                        <i class="bi bi-person-x"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-people text-muted fs-1"></i>
                            </div>
                            <h6 class="fw-bold">No Members Added</h6>
                            <p class="text-muted small mx-auto" style="max-width: 250px;">Start by adding staff members who should attend this meeting.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Staff Modal -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-labelledby="addStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="AddMember" method="post">
                <input type="hidden" name="meetingId" value="@Model.MeetingID" />
                <div class="modal-header border-0 pt-4 px-4 pb-0">
                    <h5 class="modal-title fw-bold" id="addStaffModalLabel">Add Staff Member</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Select Staff</label>
                        <select name="staffId" class="form-select rounded-3 shadow-sm border-light" required>
                            <option value="">-- Choose Staff Member --</option>
                            @foreach (var staff in availableStaff)
                            {
                                <option value="@staff.StaffID">@staff.StaffName (@staff.Department?.DepartmentName)</option>
                            }
                        </select>
                        <div class="form-text small mt-2">Only staff members not yet added to this meeting are shown.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Add to Meeting
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
